{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xmail-global",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xmail-db",
      "database_id": "926e46ce-1699-439d-96b9-78a341685a51"
    }
  ]
}